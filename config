# Navigate macOS tabs with Shift+Command+Left/Right.
keybind = shift+super+arrow_left=previous_tab
keybind = shift+super+arrow_right=next_tab

# Integrate tabs into the titlebar so each tab follows its terminal background.
macos-titlebar-style = tabs

# Use a dark tint with native macOS glass and increased transparency.
background = #0B0F14
foreground = #E6EDF3
background-opacity = 0.645
background-opacity-cells = true
background-blur = macos-glass-regular

# The zsh hook owns tab titles; keep Ghostty's other shell integration features.
shell-integration-features = cursor,no-sudo,no-title,no-ssh-env,no-ssh-terminfo,path

# Send a macOS notification when a command runs for at least five seconds
# and finishes while this terminal is not focused.
desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 5s
